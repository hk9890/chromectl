#!/bin/sh
# Prints the CHANGELOG.md section for one version, for use as release notes.
# Exits 1 when the section is missing, so a release without an entry fails
# before it publishes.
set -eu

version="${1:?usage: scripts/release-notes vX.Y.Z}"
notes=$(awk -v h="## $version" '$0 == h {p = 1; next} /^## / {p = 0} p' CHANGELOG.md)
if [ -z "$notes" ]; then
	echo "CHANGELOG.md has no section '## $version'" >&2
	exit 1
fi
printf '%s\n' "$notes"
